            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="ES0lzdQWkMOA0ozWnw8eIN" Bounds="850,60,430,15" ShowValueBox="true" isIOBox="true" Value="a place on the earth, as two numbers (x first: longitude). Type another one:">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
