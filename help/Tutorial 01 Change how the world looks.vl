            </p:NodeReference>
            <Pin Id="VdIsITkKrRT0RCeBkqjIhZ" Name="Index" Kind="InputPin" />
            <Pin Id="OJ4PsgMt6xgiqM67eDSWkp" Name="Input" Kind="InputPin" />
            <Pin Id="AHWPVSVscAkrJ3rgRsfJDJ" Name="Input 2" Kind="InputPin" />
            <Pin Id="Gx2aKjJ7o8ccEdndxWoAO8" Name="Input 3" Kind="InputPin" />
            <Pin Id="SxhBaBVfFEYjEQPIpfJxco" Name="Input 4" Kind="InputPin" />
